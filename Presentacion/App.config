<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <!-- Cadena de conexión FUERA del código (requisito: nada hardcodeado).
       Si cambias de PC, cambia Server, User Id y Password. Ejemplo local:
         Server=localhost;Port=3306;Database=SistemaVentas;User Id=root;Password=TU_CLAVE; -->
  <connectionStrings>
    <add name="SistemaVentas"
         connectionString="Server=localhost;Port=3306;Database=SistemaVentas;User Id=root;Password=;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
</configuration>
